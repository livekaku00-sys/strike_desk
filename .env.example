# ── Dhan ────────────────────────────────────────────────────────────────────
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=paste_daily_from_dhan_portal

# ── AngelOne ─────────────────────────────────────────────────────────────────
ANGEL_CLIENT_ID=your_angelone_client_id
ANGEL_API_KEY=your_angelone_api_key
ANGEL_TOTP_SECRET=your_angelone_totp_secret_base32
ANGEL_PASSWORD=your_angelone_login_password

# ── Fyers ────────────────────────────────────────────────────────────────────
FYERS_CLIENT_ID=your_fyers_app_id           # e.g. APPID123-200
FYERS_SECRET_KEY=your_fyers_app_secret
FYERS_ACCESS_TOKEN=paste_daily_from_fyers_portal

# ── App secrets (generate fresh values — never reuse the examples) ────────────
# openssl rand -hex 32
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
# openssl rand -base64 48
STRIKE_DESK_SECRET_KEY=generate_with_openssl_rand_base64_48
STRIKE_DESK_ADMIN_PASSWORD=choose_a_strong_admin_password

# ── Runtime behaviour ─────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Set PAPER_TRADING=true and REAL_TRADING=false to simulate without real money.
PAPER_TRADING=true
REAL_TRADING=false

# ── Risk limits ───────────────────────────────────────────────────────────────
DAILY_LOSS_CEILING=-2500.0
DAILY_TRADE_CAP=5
COOLDOWN_MINUTES=45
STAGNATION_TIMEOUT_MINUTES=15
EOD_SQUAREOFF_TIME=15:10

# ── Option-chain watchlist ────────────────────────────────────────────────────
# Comma-separated NSE F&O symbols to poll for option signals.
# Broker caps throttle how many can be active simultaneously; edit to taste.
FNO_OPTION_WATCHLIST=RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,SBIN,AXISBANK,KOTAKBANK,BHARTIARTL,ITC,LT,BAJFINANCE,HINDUNILVR,MARUTI,TMPV,TATASTEEL,SUNPHARMA,TITAN,ADANIENT,ADANIPORTS,ULTRACEMCO,ASIANPAINT,WIPRO,HCLTECH,NTPC,POWERGRID,COALINDIA,JSWSTEEL,GRASIM,HINDALCO
